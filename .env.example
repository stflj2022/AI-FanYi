# FilmDub AI - Environment Variables

# ==================== Database ====================
# No database URL needed (uses SQLite per project)

# ==================== API Configuration ====================
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ==================== Project Storage ====================
# Base directory for project data
# Default: ./data/projects
PROJECTS_BASE_DIR=./data/projects

# ==================== TMDB API ====================
# Get API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ==================== OMDb API (Optional) ====================
# Get API key from http://www.omdbapi.com/apikey.aspx
# OMDB_API_KEY=your_omdb_api_key_here

# ==================== LLM Configuration (Optional) ====================
# Enable LLM for research extraction
RESEARCH_LLM_ENABLED=false

# LLM API endpoint (for local models like Ollama)
LLM_BASE_URL=http://localhost:11434/v1

# LLM model name
LLM_MODEL=qwen

# ==================== Qwen Configuration (Optional) ====================
# Qwen API endpoint (for llama.cpp / llama-server)
QWEN_API_URL=http://localhost:11434/api/generate

# Qwen model name
QWEN_MODEL=qwen2.5:7b

# ==================== FFprobe Configuration ====================
# Path to ffprobe executable (if not in PATH)
# FFPROBE_PATH=/usr/bin/ffprobe

# ==================== Research Configuration ====================
# Confidence thresholds
RESEARCH_CONFIDENCE_MERGE=0.90
RESEARCH_CONFIDENCE_REVIEW=0.70

# Source reliability (0-100)
RESEARCH_RELIABILITY_OFFICIAL=100
RESEARCH_RELIABILITY_TMDB=95
RESEARCH_RELIABILITY_WIKIDATA=95
RESEARCH_RELIABILITY_WIKIPEDIA=90
RESEARCH_RELIABILITY_IMDB=85
RESEARCH_RELIABILITY_FANDOM=70
RESEARCH_RELIABILITY_WEB=50
