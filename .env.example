# 影视AI配音平台 - 环境变量配置示例
# 复制此文件为 .env 并修改为实际值

# ============================================
# 应用配置
# ============================================
ENVIRONMENT=production                    # development | production
DEBUG=0                                    # 0 | 1
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-this-in-production       # 会话加密密钥（必须修改）
VERSION=1.0.0

# ============================================
# 数据库配置
# ============================================
POSTGRES_DB=filmdubbing
POSTGRES_USER=filmdubbing
POSTGRES_PASSWORD=filmdubbing_password     # 生产环境必须修改
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://filmdubbing:filmdubbing_password@postgres:5432/filmdubbing

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ============================================
# MinIO 对象存储配置
# ============================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123             # 生产环境必须修改
MINIO_USE_HTTPS=0
MINIO_REGION=us-east-1
MINIO_BUCKET_ARTIFACTS=artifacts
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_EXPORTS=exports

# ============================================
# Celery 配置
# ============================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Shanghai
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_TRACK_STARTED=true

# ============================================
# API 配置
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false                          # 开发环境设为 true
API_TITLE=影视AI配音平台
API_VERSION=1.0.0

# ============================================
# 端口配置
# ============================================
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
FLOWER_PORT=5555
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# 媒体处理配置
# ============================================
# FFmpeg 路径（如果不在 PATH 中）
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# 最大上传文件大小（MB）
MAX_UPLOAD_SIZE=500

# 支持的视频格式
SUPPORTED_VIDEO_FORMATS=mp4,mkv,avi,mov,wmv,flv,webm

# 支持的字幕格式
SUPPORTED_SUBTITLE_FORMATS=srt,ass,vtt,ssa

# ============================================
# AI 模型配置
# ============================================
# Whisper 模型
WHISPER_MODEL=base                        # tiny | base | small | medium | large
WHISPER_CACHE_DIR=/app/models/whisper

# Pyannote 模型
PYANNOTE_MODEL=pyannote/speaker-diarization
PYANNOTE_CACHE_DIR=/app/models/pyannote

# 翻译模型（本地 LLM）
TRANSLATION_MODEL_PATH=/app/models/translation
TRANSLATION_MODEL_CACHE=/app/models/translation

# TTS 模型
TTS_ENGINE=cosyvoice                      # cosyvoice | f5-tts | edge-tts
TTS_MODEL_PATH=/app/models/tts
TTS_CACHE_DIR=/app/models/tts

# Hugging Face 配置
HF_HOME=/app/models/translation
TRANSFORMERS_CACHE=/app/models/translation
HF_HUB_OFFLINE=0                          # 离线模式
HF_DATASETS_OFFLINE=0

# ============================================
# 监控配置
# ============================================
# Prometheus
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Sentry 错误追踪
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# 外部服务 API
# ============================================
# TMDB API（用于获取影视元数据）
TMDB_API_KEY=
TMDB_LANGUAGE=zh-CN

# ============================================
# 邮件通知配置（可选）
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true

# ============================================
# 对象存储后端（可选，用于生产环境）
# ============================================
# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# 阿里云 OSS
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=

# 腾讯云 COS
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_COS_REGION=
TENCENT_COS_BUCKET=

# ============================================
# 认证配置
# ============================================
# JWT
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# OAuth（如果支持）
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ============================================
# 限流配置
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ============================================
# 文件清理配置
# ============================================
# 临时文件自动清理（小时）
TEMP_FILE_TTL=24

# 失败任务 Artifact 保留天数
FAILED_ARTIFACT_RETENTION_DAYS=7

# 完成任务 Artifact 保留天数
COMPLETED_ARTIFACT_RETENTION_DAYS=30

# ============================================
# 存储限制
# ============================================
# 单用户最大存储空间（GB）
MAX_USER_STORAGE_GB=100

# 单项目最大 Artifact 总大小（GB）
MAX_PROJECT_ARTIFACTS_GB=10

# ============================================
# GPU 配置
# ============================================
NVIDIA_VISIBLE_DEVICES=0                  # GPU 设备编号
CUDA_VISIBLE_DEVICES=0

# ============================================
# 构建配置（用于 Docker 构建）
# ============================================
BUILD_DATE=
VCS_REF=
VERSION=

# ============================================
# 部署配置
# ============================================
# 副本数
API_REPLICAS=1
CPU_WORKER_REPLICAS=1
GPU_WORKER_REPLICAS=0

# 构建目标
BUILD_TARGET=production                   # production | development
