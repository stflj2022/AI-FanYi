#!/usr/bin/env python3
"""
orchestrator.py — Unattended Development System Auto Orchestrator v1.0
Auto-generated by unattended-dev-system skill
Manages quota, progress saving, and recovery
"""

import os
import sys
import json
import time
import subprocess
from datetime import datetime, timedelta
from pathlib import Path
from typing import Dict, Optional, List
import argparse


class AutoOrchestrator:
    """Auto orchestrator for unattended development"""

    def __init__(self, config_path: str = ".unattended/config.json"):
        self.config_path = Path(config_path)
        self.base_dir = Path.cwd()
        self.unattended_dir = self.base_dir / ".unattended"
        self.log_dir = self.unattended_dir / "logs"
        self.task_dir = self.unattended_dir / "tasks"
        self.checkpoint_dir = self.unattended_dir / "checkpoints"
        self.status_file = self.unattended_dir / "status.yaml"
        self.quota_file = self.unattended_dir / "quota.json"
        
        # Create directories
        self.unattended_dir.mkdir(exist_ok=True)
        self.log_dir.mkdir(exist_ok=True)
        self.task_dir.mkdir(exist_ok=True)
        self.checkpoint_dir.mkdir(exist_ok=True)
        
        # Load configuration
        self.config = self.load_config()
        
    def load_config(self) -> Dict:
        """Load configuration"""
        default_config = {
            "driver": {
                "providers": [],
                "check_interval": 300,
                "timeout": 7200,
                "zero_output_fuse": 900
            },
            "watchdog": {
                "check_interval_minutes": 10,
                "stuck_threshold_minutes": 45
            },
            "testing": {
                "command": "",
                "auto_commit": True
            },
            "git": {
                "auto_push": True,
                "commit_message_format": "chore(driver): {message}"
            },
            "notification": {
                "enabled": False,
                "webhook": None
            }
        }
        
        if self.config_path.exists():
            with open(self.config_path) as f:
                user_config = json.load(f)
                self._deep_merge(default_config, user_config)
        
        return default_config
    
    def _deep_merge(self, base: Dict, override: Dict) -> Dict:
        """Deep merge two dicts"""
        for key, value in override.items():
            if key in base and isinstance(base[key], dict) and isinstance(value, dict):
                self._deep_merge(base[key], value)
            else:
                base[key] = value
        return base
    
    def save_config(self):
        """Save configuration"""
        self.config_path.parent.mkdir(exist_ok=True)
        with open(self.config_path, 'w') as f:
            json.dump(self.config, f, indent=2)
    
    def log(self, message: str, level: str = "INFO"):
        """Log message"""
        timestamp = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        prefixes = {
            "INFO": "ℹ️",
            "SUCCESS": "✅",
            "WARNING": "⚠️",
            "ERROR": "❌"
        }
        prefix = prefixes.get(level, "•")
        log_line = f"[{timestamp}] {prefix} {message}"
        print(log_line)
        
        # Write to log file
        log_file = self.log_dir / "orchestrator.log"
        with open(log_file, 'a') as f:
            f.write(f"[{timestamp}] [{level}] {message}\n")
    
    def save_checkpoint(self, phase: str, message: str, next_action: str, 
                       context: str = "") -> None:
        """Save progress checkpoint"""
        checkpoint = {
            "timestamp": datetime.now().isoformat(),
            "phase": phase,
            "message": message,
            "next_action": next_action,
            "context": context
        }
        
        # Save to checkpoint file
        timestamp_str = datetime.now().strftime('%Y%m%d_%H%M%S')
        checkpoint_file = self.checkpoint_dir / f"checkpoint_{timestamp_str}.json"
        with open(checkpoint_file, 'w') as f:
            json.dump(checkpoint, f, indent=2)
        
        # Update status
        self.update_status(phase, message)
        
        self.log(f"Checkpoint saved: {phase} - {message}", "SUCCESS")
    
    def update_status(self, phase: str, message: str) -> None:
        """Update status file"""
        status = {
            "phase": phase,
            "message": message,
            "last_update": datetime.now().isoformat(),
            "tasks_done": len(list(self.task_dir.glob("done/*"))),
            "tasks_total": len(list(self.task_dir.rglob("*.md")))
        }
        
        with open(self.status_file, 'w') as f:
            # Use YAML-like format
            f.write(f"phase: {phase}\n")
            f.write(f"message: {message}\n")
            f.write(f"last_update: {status['last_update']}\n")
            f.write(f"tasks_done: {status['tasks_done']}\n")
            f.write(f"tasks_total: {status['tasks_total']}\n")
    
    def generate_resume_instruction(self) -> str:
        """Generate resume instruction"""
        instruction = [
            "╔══════════════════════════════════════════════════════════════╗",
            "║              🤖 Unattended Dev System - Resume              ║",
            "╚══════════════════════════════════════════════════════════════╝",
            "",
            "@Claude Continue autonomous development task",
            "",
            "══════════════════════════════════════════════════════════════",
            "Current Status",
            "══════════════════════════════════════════════════════════════",
            ""
        ]
        
        if self.status_file.exists():
            with open(self.status_file) as f:
                instruction.append(f.read())
        
        instruction.extend([
            "",
            "══════════════════════════════════════════════════════════════",
            "Next Action",
            "══════════════════════════════════════════════════════════════",
            "",
            "Continue with the next pending task from .unattended/tasks/",
            "",
            "══════════════════════════════════════════════════════════════",
            "Commands",
            "══════════════════════════════════════════════════════════════",
            "",
            "Save checkpoint: python orchestrator.py --save <phase> <msg> <next>",
            "View status:   cat .unattended/status.yaml",
            "View logs:    tail -f .unattended/logs/driver.log",
            ""
        ])
        
        return "\n".join(instruction)
    
    def check_quota(self) -> Dict:
        """Check quota usage"""
        if not self.quota_file.exists():
            # Initialize quota file
            with open(self.quota_file, 'w') as f:
                json.dump({
                    "last_reset": datetime.now().isoformat(),
                    "tokens_used": 0,
                    "max_quota": 1000000
                }, f)
            return {"used": 0, "max": 1000000, "percentage": 0}
        
        with open(self.quota_file) as f:
            data = json.load(f)
        
        used = data.get("tokens_used", 0)
        max_quota = data.get("max_quota", 1000000)
        percentage = (used / max_quota) * 100
        
        return {"used": used, "max": max_quota, "percentage": percentage}
    
    def list_checkpoints(self) -> List[Dict]:
        """List all checkpoints"""
        checkpoints = []
        for file in sorted(self.checkpoint_dir.glob("checkpoint_*.json"), reverse=True):
            with open(file) as f:
                checkpoints.append(json.load(f))
        return checkpoints
    
    def get_status(self) -> Dict:
        """Get current status"""
        status = {
            "config_loaded": self.config_path.exists(),
            "log_dir": str(self.log_dir),
            "task_dir": str(self.task_dir),
            "checkpoints": len(list(self.checkpoint_dir.glob("*.json"))),
            "quota": self.check_quota()
        }
        
        if self.status_file.exists():
            with open(self.status_file) as f:
                for line in f:
                    if ':' in line:
                        key, value = line.split(':', 1)
                        status[key.strip()] = value.strip()
        
        return status


def main():
    """Main entry point"""
    parser = argparse.ArgumentParser(description='Unattended Dev System Orchestrator')
    parser.add_argument('--config', default='.unattended/config.json', help='Config file path')
    parser.add_argument('--check', action='store_true', help='Check quota and status')
    parser.add_argument('--save', nargs=4, metavar=('PHASE', 'MESSAGE', 'NEXT', 'CONTEXT'),
                       help='Save checkpoint')
    parser.add_argument('--resume', action='store_true', help='Generate resume instruction')
    parser.add_argument('--status', action='store_true', help='Show current status')
    parser.add_argument('--list-checkpoints', action='store_true', help='List all checkpoints')
    
    args = parser.parse_args()
    
    orchestrator = AutoOrchestrator(args.config)
    
    if args.check:
        quota = orchestrator.check_quota()
        print(f"Quota: {quota['percentage']:.1f}% ({quota['used']}/{quota['max']})")
        status = orchestrator.get_status()
        print(f"Checkpoints: {status['checkpoints']}")
    
    elif args.save:
        orchestrator.save_checkpoint(args.save[0], args.save[1], args.save[2], args.save[3] or "")
    
    elif args.resume:
        print(orchestrator.generate_resume_instruction())
    
    elif args.status:
        status = orchestrator.get_status()
        print(json.dumps(status, indent=2, default=str))
    
    elif args.list_checkpoints:
        checkpoints = orchestrator.list_checkpoints()
        for cp in checkpoints:
            print(f"{cp['timestamp']}: {cp['phase']} - {cp['message']}")
    
    else:
        parser.print_help()


if __name__ == '__main__':
    main()
