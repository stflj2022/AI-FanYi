#!/bin/bash
# shutdown.sh — Unattended Development System Shutdown v1.2.0
# Auto-generated by unattended-dev-system skill
# One-stop shutdown when the project is complete (idempotent).
# Called automatically by driver.sh / watchdog.sh on completion, or manually.
# Effect: remove watchdog/report cron entries, write STOPPED marker, kill the
#         driver, and send ONE final notification. After this, nothing in the
#         unattended system restarts or notifies again.

set -u
# Ignore SIGHUP: when the driver (our parent) runs inside a tmux pane, killing
# the session below sends SIGHUP to the whole foreground process group.
# Without this trap we would die BEFORE the final notification goes out.
trap '' HUP

# ============================================
# CONFIGURATION
# ============================================

REPO="{{PROJECT_ROOT}}"
LOG_DIR="$REPO/.unattended"
SHUTDOWN_LOG="$LOG_DIR/shutdown.log"
STOPPED_MARKER="$LOG_DIR/STOPPED"
SESSION_NAME="{{SESSION_NAME}}"
LOCK_FILE="/tmp/{{PROJECT_NAME}}-shutdown.lock"
# Repo path escaped for use in ERE contexts (pkill -f / grep -E)
REPO_RE="$(printf '%s' "$REPO" | sed 's/[].[\\*^$()+?{|]/\\&/g')"

mkdir -p "$LOG_DIR"

log() {
    echo "[$(date '+%F %T')] $*" >> "$SHUTDOWN_LOG"
}

# Single-instance guard using flock where available
if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        exit 0
    fi
fi

# Idempotent: already stopped → exit silently (no repeat notifications)
if [ -f "$STOPPED_MARKER" ]; then
    exit 0
fi

log "🛑 Shutting down unattended system (reason: ${1:-project complete})"

# 1) Remove watchdog / report cron entries (keep unrelated crontab lines).
#    Matches the exact line documented in install.sh ($REPO/watchdog.sh) plus
#    any *report*.sh scheduled from the repo root. Backs up the crontab first.
if command -v crontab >/dev/null 2>&1 && crontab -l >/dev/null 2>&1; then
    CRON_BACKUP="$LOG_DIR/crontab.bak.$(date '+%Y%m%d-%H%M%S')"
    crontab -l 2>/dev/null > "$CRON_BACKUP" || true
    grep -E -v -e "$REPO_RE/watchdog\.sh" -e "$REPO_RE/[^ ]*report[^ ]*\.sh" "$CRON_BACKUP" \
        | crontab - 2>/dev/null || true
    log "⏹  Removed watchdog/report cron entries (backup: $CRON_BACKUP)"
fi

# 2) Write STOPPED marker (driver/watchdog exit silently when they see it)
date '+%F %T %Z' > "$STOPPED_MARKER"

# 3) Send ONE final notification FIRST: killing the tmux session / driver
#    below can take this script down with it even with the HUP trap, so the
#    notification must go out before any destructive step.
TITLE="🎉 {{PROJECT_NAME}} complete"
BODY="Unattended dev system auto-stopped: driver, watchdog and scheduled reports are all shut down. Re-run install.sh to restart."
if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name="{{PROJECT_NAME}}" --icon="dialog-information" "$TITLE" "$BODY" 2>/dev/null || true
elif command -v osascript >/dev/null 2>&1; then
    osascript -e "display notification \"$BODY\" with title \"$TITLE\"" 2>/dev/null || true
fi
log "📨 Final completion notification sent"

# 4) Kill tmux session and any leftover driver processes
if command -v tmux >/dev/null 2>&1; then
    tmux kill-session -t "$SESSION_NAME" 2>/dev/null || true
fi
pkill -f "$REPO_RE/driver\.sh" 2>/dev/null || true

log "✅ Unattended system fully stopped (driver + watchdog + reports)"
exit 0
