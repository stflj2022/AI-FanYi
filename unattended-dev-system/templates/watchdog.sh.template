#!/bin/bash
# watchdog.sh — Unattended Development System Watchdog v1.2.0
# Auto-generated by unattended-dev-system skill
# Enhanced with platform detection and improved error handling

set -e

# ============================================
# CONFIGURATION
# ============================================

REPO="{{PROJECT_ROOT}}"
LOG_DIR="$REPO/.unattended"
WATCHDOG_LOG="$LOG_DIR/watchdog.log"
DRIVER_LOG="$REPO/.unattended/driver.log"
DRIVER_SCRIPT="$REPO/driver.sh"
SESSION_NAME="{{SESSION_NAME}}"
STUCK_THRESHOLD={{STUCK_THRESHOLD_MINUTES}}
LOCK_FILE="/tmp/{{PROJECT_NAME}}-watchdog.lock"

# ============================================
# LOGGING
# ============================================

log() {
    echo "[$(date '+%F %T')] $*" >> "$WATCHDOG_LOG"
}

log_warning() {
    echo "[$(date '+%F %T')] ⚠️  $*"
}

log_error() {
    echo "[$(date '+%F %T')] ❌ $*"
}

log_success() {
    echo "[$(date '+%F %T')] ✅ $*"
}

# ============================================
# PLATFORM DETECTION
# ============================================

detect_platform() {
    case "$(uname -s)" in
        Linux*)  PLATFORM="linux" ;;
        Darwin*) PLATFORM="macos" ;;
        MINGW*|MSYS*) PLATFORM="windows" ;;
        *)       PLATFORM="generic" ;;
    esac
}

# Get file age in seconds (returns age, not mtime). Platform-independent.
get_file_age() {
    local file="$1" mtime now
    if [ ! -f "$file" ]; then
        echo "0"
        return
    fi

    case "$PLATFORM" in
        linux)   mtime=$(stat -c %Y "$file" 2>/dev/null) ;;
        macos)   mtime=$(stat -f %m "$file" 2>/dev/null) ;;
        generic) mtime=$(stat -c %Y "$file" 2>/dev/null) ;;
        windows) mtime=$(stat -c %Y "$file" 2>/dev/null) ;;
        *)       mtime=$(stat -c %Y "$file" 2>/dev/null) ;;
    esac

    # Guard against non-numeric / zero mtime
    case "$mtime" in
        ''|*[!0-9]*) echo "0"; return ;;
    esac
    [ "$mtime" -gt 0 ] 2>/dev/null || { echo "0"; return; }

    now=$(date +%s)
    echo $(( now - mtime ))
}

# ============================================
# CONFIG LOADING (reads .unattended/config.json at runtime)
# ============================================

load_cfg() {
    local key="$1" default="$2" val
    val=$(python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    for k in sys.argv[2].split('.'):
        d = d[k]
    print(str(d).lower() if isinstance(d, bool) else d)
except Exception:
    sys.exit(1)
" "$REPO/.unattended/config.json" "$key" 2>/dev/null)
    echo "${val:-$default}"
}

# Override STUCK_THRESHOLD from config.json if present
STUCK_THRESHOLD=$(load_cfg "watchdog.stuck_threshold_minutes" "$STUCK_THRESHOLD")

# ============================================
# CHECKS
# ============================================

# Resolve platform once (S-006: detect_platform was defined but never called)
detect_platform

# Single-instance guard using flock where available
if command -v flock >/dev/null 2>&1 && [ "$PLATFORM" != "windows" ]; then
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        exit 0
    fi
fi

# 0) Already shut down (completion auto-stop or manual) → never intervene, never restart
if [ -f "$LOG_DIR/STOPPED" ]; then
    exit 0
fi

# 1) All work done → one-stop shutdown (stops driver/reports, sends ONE final notification)
#    The driver.log phrase alone is NOT sufficient: the log also contains raw AI
#    output that may quote it. Require the tasks directory state as well
#    (todo/doing empty, done non-empty) before shutting anything down.
tasks_all_done() {
    [ -d "$REPO/.unattended/tasks/done" ] || return 1
    [ -n "$(ls -A "$REPO/.unattended/tasks/done" 2>/dev/null)" ] || return 1
    [ -z "$(ls -A "$REPO/.unattended/tasks/todo" 2>/dev/null)" ] || return 1
    [ -z "$(ls -A "$REPO/.unattended/tasks/doing" 2>/dev/null)" ] || return 1
    return 0
}
if [ -f "$DRIVER_LOG" ] && tail -50 "$DRIVER_LOG" | grep -q "ALL TASKS COMPLETED" && tasks_all_done; then
    log "🎉 All work completed → auto-shutdown"
    "$REPO/shutdown.sh" "all tasks complete (watchdog)" >> "$WATCHDOG_LOG" 2>&1 || true
    exit 0
fi

# 2) Driver process alive check
if pgrep -f "driver.sh" >/dev/null; then
    # 卡死检测：日志超过 STUCK_THRESHOLD 分钟无更新 → 杀掉挂起的 AI 轮次
    if [ -f "$DRIVER_LOG" ]; then
        AGE=$(get_file_age "$DRIVER_LOG")
        STUCK_SECONDS=$((STUCK_THRESHOLD * 60))
        if [ "$AGE" -gt "$STUCK_SECONDS" ]; then
            log_warning "Driver stuck (log not updated for $STUCK_THRESHOLD minutes, age=${AGE}s)"

            PIPID=$(pgrep -f "^timeout.*pi" | head -1)
            if [ -n "$PIPID" ]; then
                log "Killing stuck AI process (PID: $PIPID)"
                pkill -P "$PIPID" 2>/dev/null
                kill "$PIPID" 2>/dev/null
            fi
        fi
    fi
    exit 0
fi

# 3) Driver not running → restart
log "🚨 Driver not running, attempting restart..."

# Kill existing session
tmux kill-session -t "$SESSION_NAME" 2>/dev/null || true

# Start new session
tmux new-session -d -s "$SESSION_NAME" "$DRIVER_SCRIPT"

if [ $? -eq 0 ]; then
    log_success "Driver restarted successfully"
else
    log_error "Failed to restart driver"
    exit 1
fi
