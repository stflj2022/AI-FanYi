#!/bin/bash
# watchdog.sh — Unattended Development System Watchdog v1.1
# Auto-generated by unattended-dev-system skill
# Enhanced with platform detection and improved error handling

set -e

# ============================================
# CONFIGURATION
# ============================================

REPO="{{PROJECT_ROOT}}"
LOG_DIR="$REPO/.unattended"
WATCHDOG_LOG="$LOG_DIR/watchdog.log"
DRIVER_LOG="$REPOPO/.unattended/driver.log"
DRIVER_SCRIPT="$REPO/driver.sh"
SESSION_NAME="{{SESSION_NAME}}"
STUCK_THRESHOLD={{STUCK_THRESHOLD_MINUTES}}
LOCK_FILE="/tmp/{{PROJECT_NAME}}-watchdog.lock"

# ============================================
# LOGGING
# ============================================

log() {
    echo "[$(date '+%F %T')] $*" >> "$WATCHDOG_LOG"
}

log_warning() {
    echo "[$(date '+%F %T')] ⚠️  $*"
}

log_error() {
    echo "[$(date '+%F %T')] ❌ $*"
}

log_success() {
    echo "[$(date '+%F %T')] ✅ $*"
}

# ============================================
# PLATFORM DETECTION
# ============================================

detect_platform() {
    case "$(uname -s)" in
        Linux*)  PLATFORM="linux" ;;
        Darwin*)  PLATFORM="macos" ;;
        MINGW*|MSYS*) PLATFORM="windows" ;;
        *)     PLATFORM="generic" ;;
    esac
}

# Get file age in seconds (platform-independent)
get_file_age() {
    local file="$1"
    if [ ! -f "$file" ]; then
        echo "0"
        return
    fi
    
    case "$PLATFORM" in
        linux|macos)
            stat -c %Y "$file" 2>/dev/null || echo "0"
            ;;
        windows)
            powershell -Command "Get-Item \"$file\" | ForEach-Object { $($_.LastWriteTime -le '{}' -First 1)" 2>/dev/null || echo "0"
            ;;
        *)
            echo "0"
            ;;
    esac
}

# ============================================
# CHECKS
# ============================================

# 1) All work done → no intervention
if [ -f "$DRIVER_LOG" ] && tail -50 "$DRIVER_LOG" | grep -q "ALL TASKS COMPLETED"; then
    log "All work completed, no intervention needed"
    exit 0
fi

# 2) Driver process alive check
if pgrep -f "driver.sh" >/dev/null; then
    # 卡死检测：日志 60 分钟无更新 → 杀掉挂起的 pi 轮次
    if [ -f "$DRIVER_LOG" ]; then
        AGE=$(get_file_age "$DRIVER_LOG")
        STUCK_SECONDS=$((STUCK_THRESHOLD * 60))
        if [ "$AGE" -gt "$STUCK_SECONDS" ]; then
            log_warning "Driver stuck (log not updated for $STUCK_THRESHOLD minutes)"
            
            PIPID=$(pgrep -f "^timeout.*pi" | head -1)
            if [ -n "$PIPID" ]; then
                log "Killing stuck AI process (PID: $PIPID)"
                pkill -P "$PIPID" 2>/dev/null
                kill "$PIPID" 2>/dev/null
            fi
        fi
    fi
    exit 0
fi

# 3) Driver not running → restart
log "🚨 Driver not running, attempting restart..."

# Kill existing session
tmux kill-session -t "$SESSION_NAME" 2>/dev/null || true

# Start new session
tmux new-session -d -s "$SESSION_NAME" "$DRIVER_SCRIPT"

if [ $? -eq 0 ]; then
    log_success "Driver restarted successfully"
else
    log_error "Failed to restart driver"
    exit 1
fi
