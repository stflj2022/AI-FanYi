#!/bin/bash
# driver.sh — Unattended Development System Driver v1.1
# Auto-generated by unattended-dev-system skill
# Enhanced with security validation, error handling, and platform support
# Project: {{PROJECT_NAME}}
# Language: {{LANGUAGE}}
# Framework: {{FRAMEWORK}}

set -euo pipefail

# Enable error tracing for debugging
trap 'log_error "Line $LINENO: Command failed with code $?"; exit 1' ERR

# ============================================
# CONFIGURATION
# ============================================

# Validate and resolve REPO path
if [ ! -d "{{PROJECT_ROOT}}" ]; then
    log_error "Repository path does not exist: {{PROJECT_ROOT}}"
    exit 1
fi

REPO=$(realpath "{{PROJECT_ROOT}}")

LOG_DIR="$REPO/.unattended"
LOG="$LOG_DIR/driver.log"
STATUS="$LOG_DIR/status.yaml"
TASKS_DIR="$LOG_DIR/tasks"
CHECKPOINT_DIR="$LOG_DIR/checkpoints"

# Create directories
mkdir -p "$LOG_DIR" "$TASKS_DIR" "$CHECKPOINT_DIR"

# AI Providers (configurable)
PROVIDERS=({{PROVIDERS}})
CURRENT_PROVIDER=0
PROVIDER_COUNT=${#PROVIDERS[@]}
FAILS=0

# Test command (configurable)
TEST_COMMAND="{{TEST_COMMAND}}"

# Git configuration
GIT_AUTO_PUSH={{GIT_AUTO_PUSH}}
COMMIT_PREFIX="{{COMMIT_PREFIX}}"

# Timeout settings
DRIVER_TIMEOUT={{DRIVER_TIMEOUT}}
ZERO_OUTPUT_FUSE={{ZERO_OUTPUT_FUSE}}

# Dry run mode (for testing)
DRY_RUN=false

# ============================================
# LOGGING
# ============================================

log() {
    echo "[$(date '+%F %T')] $*" >> "$LOG"
    echo "[$(date '+%F %T')] $*"
}

log_error() {
    echo "[$(date '+%F %T')] ❌ $*" >> "$LOG"
    echo "[$(date '+%F %T')] ❌ $*" >&2
}

log_success() {
    echo "[$(date '+%F %T')] ✅ $*" >> "$LOG"
    echo "[$(date '+%F %T')] ✅ $*"
}

# ============================================
# SECURITY VALIDATION
# ============================================

validate_path() {
    local path="$1"
    # Resolve absolute path
    path=$(realpath "$path" 2>/dev/null) || return 1
    
    # Check path is within allowed directories
    case "$path" in
        "$HOME"|"$HOME/"*) ;;  # Allow home directory
        */*) ;;
        *)
            log_error "Path outside allowed directories: $path"
            return 1 ;;
    esac
    
    return 0
}

validate_ai_command() {
    local cmd="$1"
    
    # Check for dangerous patterns (prevent injection)
    if echo "$cmd" | grep -EqE '[;&|>||\$\(|\`|\\|/dev/' 2>/dev/null; then
        log_error "Invalid characters in AI command: $cmd"
        return 1
    fi
    
    # Validate command format - basic check
    if ! [[ "$cmd" =~ ^[a-zA-Z0-9_\-\s]+$ ]]; then
        log_error "AI command contains invalid characters: $cmd"
        return 1
    fi
    
    return 0
}

# ============================================
# UTILITY FUNCTIONS
# ============================================

cur_provider() {
    echo "${PROVIDERS[$CURRENT_PROVIDER]}"
}

# Check if tests pass
tests_pass() {
    (cd "$REPO" && timeout 600 $TEST_COMMAND >/dev/null 2>&1)
}

# Check if all tasks done
all_done() {
    [ "$(ls "$TASKS_DIR/done/" 2>/dev/null | wc -l)" -eq "{{TOTAL_TASKS}}" ]
}

# Get current round output
round_output() {
    local mark; mark=$(cat "$LOG_DIR/.round_mark" 2>/dev/null || echo "0")
    tail -c +$((mark+1)) "$LOG" 2>&1
}

# Detect quota hit
quota_hit() {
    round_output | grep -qiE "quota|额度|429|rate.?limit|insufficient|exceeded|余额不足|balance"
}

# Detect context overflow
ctx_hit() {
    round_output | grep -qiE "context.{0,20}(length|limit|window|overflow)|maximum context|too long|token limit"
}

# Detect zero output
zero_output() {
    local mark; mark=$(cat "$LOG_DIR/.round_mark" 2>/dev/null || echo "0")
    local current_size; current_size=$(stat -c %s "$LOG" 2>&1)
    [ "$current_size" -le "$mark" ]
}

# Save status
save_status() {
    cat > "$STATUS" << EOF
status: "$1"
provider: "$(cur_provider)"
provider_index: $CURRENT_PROVIDER
failures: $FAILS
last_update: "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
tasks_done: $(ls "$TASKS_DIR/done/" 2>/dev/null | wc -l)
tasks_total: $(ls "$TASKS_DIR"/todo/ "$TASKS_DIR"/doing/  2>/dev/null | wc -l)
EOF
}

# Save checkpoint
save_checkpoint() {
    local phase="$1"
    local message="$2"
    local next="$3"
    local context="$4"

    local timestamp
    timestamp=$(date -u +%Y%m%d_%H%M%S)
    local checkpoint_file="$CHECKPOINT_DIR/checkpoint_${timestamp}.json"

    cat > "$checkpoint_file" << EOF
{
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "phase": "$phase",
  "message": "$message",
  "next": "$next",
  "provider": "$(cur_provider)",
  "context": "$context"
}
EOF

    log_success "Checkpoint saved: $phase - $message"
}

# Auto commit and push
auto_commit() {
    if [ -n "$(git -C "$REPO" --porcelain 2>/dev/null)" ]; then
        local message="$1"
        local timestamp
        timestamp=$(date '+%F %T')
        
        cd "$REPO" || exit 1
        
        git add -A
        git commit -m "${COMMIT_PREFIX} ${timestamp}: ${message}" --allow-empty -q
        
        if [ "$GIT_AUTO_PUSH" = "true" ]; then
            git push -q origin HEAD 2>&1 && log_success "Pushed to GitHub" || log_error "Push failed"
        else
            log_success "Committed locally (auto_push disabled)"
        fi
    fi
}

# ============================================
# MAIN LOOP
# ============================================

# Initialize
cd "$REPO" || exit 1
log "=== UNATTENDED DRIVER STARTED v1.1 ==="
log "Project: {{PROJECT_NAME}}"
log "Providers: ${PROVIDER_COUNT} configured"
log "Test command: $TEST_COMMAND"
log "Mode: $([ "$DRY_RUN" = true ] && echo '(DRY RUN)' || echo '(LIVE)')"
log "Platform: $(uname -s)"

# Main loop
ROUND=0
while true; do
    ROUND=$((ROUND + 1))
    log "=== ROUND $ROUND ==="
    log "Provider: $(cur_provider)"

    # Save round mark for output detection
    stat -c %s "$LOG" > "$LOG_DIR/.round_mark" 2>/dev/null || echo "0"

    # Check for ALL_DONE
    if all_done && tests_pass; then
        log_success "🎉 ALL TASKS COMPLETED AND TESTS PASS"
        save_status "COMPLETED"
        auto_commit "All tasks completed"
        break
    fi

    # Execute AI agent (skip if dry run)
    if [ "$DRY_RUN" != "true" ]; then
        log "Starting AI agent..."
        timeout $DRIVER_TIMEOUT {{AI_COMMAND}} >> "$LOG" 2>&1
        EXIT_CODE=$?

        # Handle result
        if [ $EXIT_CODE -eq 0 ]; then
            log_success "Round completed successfully"
            auto_commit "Auto checkpoint - Round $ROUND"
        elif [ $EXIT_CODE -eq 124 ]; then
            log_error "Timeout after $DRIVER_TIMEOUT seconds"
            save_checkpoint "timeout" "Driver timeout" "Retry next round" "Round $ROUND timeout"
        elif [ $EXIT_CODE -ne 0 ]; then
            log_error "Agent failed with code $EXIT_CODE"
        fi
    fi

    # Detect issues and handle
    if quota_hit; then
        log "⚠️ Quota limit hit"
        FAILS=$((FAILS + 1))
        
        if [ "$FAILS" -ge $PROVIDER_COUNT ]; then
            log_error "All providers failed, waiting 900s"
            sleep 900
            FAILS=0
        else
            CURRENT_PROVIDER=$(( (CURRENT_PROVIDER + 1) % PROVIDER_COUNT))
            log "Switching to provider: $(cur_provider)"
        fi
    fi

    if ctx_hit; then
        log "⚠️ Context overflow, starting fresh session"
        save_checkpoint "context_overflow" "Context full" "Restart fresh" "Round $ROUND"
        touch "$LOG_DIR/FRESH_NEXT"
    fi

    # Check if all providers failed
    if [ "$FAILS" -ge $PROVIDER_COUNT ]; then
        log_error "All providers failed, waiting 900s"
        sleep 900
        FAILS=0
    fi

    # Save status and wait
    save_status "RUNNING"
    log "Round complete, waiting 30s..."
    sleep 30
done

log "=== DRIVER FINISHED ==="
