[Unit]
Description=AI-FanYi Web UI Autonomous Driver
After=network.target

[Service]
Type=simple
Environment=PROJECT_ROOT=%h/桌面/AI-FanYi
ExecStart=%h/桌面/AI-FanYi/scripts/web-ui-driver.sh
WorkingDirectory=%h/桌面/AI-FanYi
# on-failure：驱动正常退出（完工自停，exit 0）后不再被拉起；
# 崩溃类故障仍自动重启。切勿改回 Restart=always——完工后驱动每轮秒退，
# always 会导致无限复活空转。
Restart=on-failure
RestartSec=30
# 防止日志无限增长
StandardOutput=append:%h/桌面/AI-FanYi/.claude/web-ui-driver.log
StandardError=append:%h/桌面/AI-FanYi/.claude/web-ui-driver.log

[Install]
WantedBy=default.target
