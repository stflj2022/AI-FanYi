[Unit]
Description=AI-FanYi Unattended Development Driver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PROJECT_ROOT=%h/桌面/AI-FanYi
ExecStart=%h/桌面/AI-FanYi/scripts/pi-unattended.sh
WorkingDirectory=%h/桌面/AI-FanYi
# on-failure：驱动正常退出（完工自停，exit 0）后不再被拉起；
# 崩溃类故障仍自动重启，并由 watchdog timer 兜底。
Environment=http_proxy=http://127.0.0.1:10808
Environment=https_proxy=http://127.0.0.1:10808
Environment=no_proxy=localhost,127.0.0.1,::1
Environment=HTTP_PROXY=http://127.0.0.1:10808
Environment=HTTPS_PROXY=http://127.0.0.1:10808
Environment=NO_PROXY=localhost,127.0.0.1,::1
Restart=on-failure
RestartSec=30
# 防止日志无限增长
StandardOutput=append:%h/桌面/AI-FanYi/.claude/driver-stdout.log
StandardError=append:%h/桌面/AI-FanYi/.claude/driver-stderr.log

[Install]
WantedBy=default.target
