# 影视AI配音平台 - API Docker 镜像
# 多阶段构建优化镜像大小和构建效率

# ============================================
# 阶段 1: 基础依赖层
# ============================================
FROM python:3.11-slim AS base

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    # FFmpeg 和编解码器
    ffmpeg \
    libavcodec-extra \
    libavdevice-extra \
    libavfilter-extra \
    libavformat-extra \
    libavresample-extra \
    libavutil-extra \
    libpostproc-extra \
    libswresample-extra \
    libswscale-extra \
    # 媒体处理工具
    sox \
    libsox-dev \
    libsox-fmt-all \
    # 图像处理
    libgl1-mesa-glx \
    libglib2.0-0 \
    # 其他工具
    curl \
    git \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ============================================
# 阶段 2: 依赖安装层
# ============================================
FROM base AS dependencies

WORKDIR /app

# 只复制依赖文件用于缓存优化
COPY requirements.txt .
COPY requirements-dev.txt .

# 安装生产依赖
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# 安装开发依赖（可选）
RUN pip install --no-cache-dir -r requirements-dev.txt || true

# ============================================
# 阶段 3: 模型预加载（可选）
# ============================================
FROM dependencies AS models

# 预下载常用模型到 shared volume
RUN mkdir -p /app/models && \
    # Whisper 模型（小）
    python -c "import whisper; whisper.load_model('tiny')" || true && \
    # 创建模型目录结构
    mkdir -p /app/models/whisper \
             /app/models/pyannote \
             /app/models/translation \
             /app/models/tts

# ============================================
# 阶段 4: 生产镜像
# ============================================
FROM python:3.11-slim AS production

# 复制系统依赖
COPY --from=base / /

WORKDIR /app

# 复制 Python 包
COPY --from=dependencies /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=dependencies /usr/local/bin /usr/local/bin

# 复制源代码
COPY src/ /app/src/
COPY scripts/ /app/scripts/
COPY docs/ /app/docs/

# 复制模型（如果有预训练模型）
COPY --from=models /app/models /app/models 2>/dev/null || true

# 创建必要的目录
RUN mkdir -p /app/artifacts \
             /app/uploads \
             /app/logs \
             /app/temp \
             /app/cache \
             /app/models/whisper \
             /app/models/pyannote \
             /app/models/tts && \
    # 设置权限
    chmod +x /app/scripts/*.sh || true

# 环境变量
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # 模型缓存路径
    TRANSFORMERS_CACHE=/app/models/translation \
    HF_HOME=/app/models/translation \
    WHISPER_CACHE_DIR=/app/models/whisper

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 暴露端口
EXPOSE 8000

# 默认启动命令（可被覆盖）
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]

# ============================================
# 阶段 5: 开发镜像（包含热重载）
# ============================================
FROM production AS development

# 安装开发工具
RUN pip install --no-cache-dir \
    watchfiles \
    pytest-watch \
    ipython \
    jupyter

# 开发环境变量
ENV ENVIRONMENT=development \
    DEBUG=1

# 开发模式启动命令（热重载）
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
