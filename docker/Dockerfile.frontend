# ============================================
# Frontend Dockerfile
# ============================================

# 构建阶段
FROM node:20-alpine as builder

WORKDIR /app

# 可选注入 Vite 环境变量（如自定义部署域名）；不传时前端默认走同源相对路径 /api/v1
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_WS_URL
ENV VITE_WS_URL=$VITE_WS_URL

# 复制 package 文件
COPY src/filmdub/apps/web/frontend/package*.json ./

# 安装依赖
RUN npm ci

# 复制源代码
COPY src/filmdub/apps/web/frontend/ ./

# 构建生产版本
RUN npm run build

# ============================================
# 运行阶段
# ============================================

FROM nginx:alpine

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制 nginx 配置
COPY docker/nginx.conf /etc/nginx/nginx.conf

# 暴露端口
EXPOSE 80

# 启动 nginx
CMD ["nginx", "-g", "daemon off;"]
